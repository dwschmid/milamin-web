    given-names: Daniel W.
    orcid: https://orcid.org/0000-0002-4271-0858
    affiliation: Bergwerk, Sandefjord, Norway
    email: dani.schmid@bergwerk.com
version: 1.0.0
date-released: 2026-09-22
license: GPL-2.0-or-later
repository-code: https://github.com/dwschmid/milamin-web
url: https://milamin.org
keywords:
  - finite element method
  - Stokes flow
  - WebAssembly
  - TypeScript
  - sparse Cholesky
  - MILAMIN
  - geodynamics
  - structural geology
references:
